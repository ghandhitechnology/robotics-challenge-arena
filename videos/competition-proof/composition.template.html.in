<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=1920, height=1080" />
  <title>Competition robot proof</title>
  <script src="assets/gsap.min.js"></script>
  <style>
    @font-face { font-family: Barlow; src: url("assets/fonts/Barlow-SemiBold.ttf"); font-weight: 600; }
    @font-face { font-family: "IBM Plex Mono"; src: url("assets/fonts/IBMPlexMono-Regular.ttf"); font-weight: 400; }
    * { box-sizing: border-box; margin: 0; }
    html, body { width: 1920px; height: 1080px; overflow: hidden; background: #12181b; color: #eef1e9; }
    #root { width: 1920px; height: 1080px; padding: 20px; display: grid; grid-template-columns: 1440px 420px; gap: 20px; font-family: Barlow, sans-serif; }
    #recording-slot { position: relative; grid-column: 1; width: 1440px; height: 1040px; }
    #recording { width: 1440px; height: 1040px; object-fit: contain; background: #12181b; }
    #report { grid-column: 2; height: 1040px; padding: 28px; background: #1b2428; display: flex; flex-direction: column; gap: 19px; }
    .eyebrow { color: #dfc779; font-size: 24px; line-height: 1.2; }
    h1 { font-size: 58px; font-weight: 600; line-height: 1.02; }
    .subline { margin-top: 14px; color: #c4cec9; font-size: 26px; line-height: 1.25; }
    .label { color: #c4cec9; font-size: 24px; line-height: 1.2; }
    .score { font-family: "IBM Plex Mono", monospace; font-size: 78px; line-height: 1.25; font-variant-numeric: tabular-nums; letter-spacing: -4px; }
    .status { color: #dfc779; font-size: 28px; line-height: 1.2; }
    .task-list { display: grid; gap: 13px; border-top: 2px solid #43534f; padding-top: 22px; }
    .task { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 27px; line-height: 1.25; }
    .number { font-family: "IBM Plex Mono", monospace; font-size: 25px; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .facts { display: grid; gap: 17px; margin-top: auto; border-top: 2px solid #43534f; padding-top: 22px; }
    .fact { display: grid; gap: 5px; }
    .fact .number { font-size: 29px; }
    .footnote { color: #c4cec9; font-size: 23px; line-height: 1.3; }
  </style>
</head>
<body>
  <div id="root" data-composition-id="competition-proof" data-width="1920" data-height="1080" data-duration="__DURATION__">
    <div id="recording-slot"><video id="recording" class="clip" src="assets/trajectory.mp4" data-start="0" data-duration="__DURATION__" data-track-index="0" muted playsinline></video></div>
    <aside id="report">
      <div>
        <p class="eyebrow">__MODE__</p>
        <h1>Competition run</h1>
        <p class="subline">__CONTROLLER__</p>
      </div>
      <div>
        <p class="label">Final task score</p>
        <p class="score">__SCORE__</p>
        <p class="status">__STATUS__</p>
      </div>
      <div class="task-list">__TASK_ROWS__</div>
      <div class="facts">
        <div class="fact"><p class="label">Recorded simulation</p><p class="number">__SIM_SECONDS__ s</p></div>
        <div class="fact"><p class="label">Official time limit</p><p class="number">__OFFICIAL_LIMIT__</p></div>
        <div class="fact"><p class="label">Numerical warnings</p><p class="number">__WARNINGS__</p></div>
      </div>
      <p class="footnote">__FOOTNOTE__</p>
    </aside>
  </div>
  <script>
    const tl = gsap.timeline({ paused: true });
    window.__timelines["competition-proof"] = tl;
  </script>
</body>
</html>
